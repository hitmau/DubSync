<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DubSync.Desktop</AssemblyName>
    <RootNamespace>DubSync.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\launcher\dubsync.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Arc" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Json" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\review_ui\static\dubsync-icon.png" Link="Assets\dubsync-icon.png" />
  </ItemGroup>

</Project>
