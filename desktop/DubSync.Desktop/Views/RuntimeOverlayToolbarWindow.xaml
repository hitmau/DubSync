<Window x:Class="DubSync.Desktop.Views.RuntimeOverlayToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DubSync · Ferramentas de captura"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Chrome" Background="#F21A2637" BorderBrush="#FF41617E"
            BorderThickness="1" CornerRadius="9" Padding="4">
        <DockPanel LastChildFill="True">
            <TextBlock x:Name="StatusLabel" DockPanel.Dock="Bottom" Text="Captura Real"
                       Foreground="#FFCFDDED" FontSize="9" TextWrapping="Wrap"
                       Width="132" Margin="2,5,2,2" />
            <Border x:Name="Grip" DockPanel.Dock="Top" Height="20" CornerRadius="5"
                    Background="#FF25364B" Cursor="SizeAll" ToolTip="Arraste para mover a barra">
                <TextBlock x:Name="GripGlyph" Text="⋮⋮" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#FFAFC5D9" FontSize="13" />
            </Border>
            <StackPanel x:Name="ButtonStack" Orientation="Vertical" />
        </DockPanel>
    </Border>
</Window>
