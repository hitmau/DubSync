<UserControl x:Class="DubSync.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,34" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="PREFERÊNCIAS DO DESKTOP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
            <TextBlock Text="Configurações" FontSize="29" FontWeight="Bold" Margin="0,6,0,4" />
            <TextBlock Text="Ajuste a conexão com o serviço DubSync, o zoom da interface e o tamanho dos textos." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22" />

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="21" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Serviço local" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="A interface nativa usa a API Python atual. A porta informada é local ao computador." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                    <TextBlock Text="Porta da API" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Text="{Binding ApiPortInput, UpdateSourceTrigger=PropertyChanged}" Width="170" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="21" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Aparência e leitura" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Zoom e fonte são independentes. O Windows continua controlando o DPI do monitor." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Escala da interface" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox Width="190" HorizontalAlignment="Left" Margin="0,6,18,0" SelectedValue="{Binding UiScaleSelection, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="100%" Tag="1" />
                                <ComboBoxItem Content="110%" Tag="1.1" />
                                <ComboBoxItem Content="125%" Tag="1.25" />
                                <ComboBoxItem Content="150%" Tag="1.5" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tamanho da fonte" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox Width="190" HorizontalAlignment="Left" Margin="0,6,0,0" SelectedValue="{Binding FontScaleSelection, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Compacto" Tag="0.9" />
                                <ComboBoxItem Content="Normal" Tag="1" />
                                <ComboBoxItem Content="Grande" Tag="1.15" />
                                <ComboBoxItem Content="Muito grande" Tag="1.3" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="Salvar preferências" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="180" Click="Save_Click" />
            <TextBlock Text="As preferências e o layout ficam em %APPDATA%\DubSync\Desktop. Elas não alteram o banco de projetos." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
