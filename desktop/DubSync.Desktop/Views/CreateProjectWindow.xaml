<Window x:Class="DubSync.Desktop.Views.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo projeto · DubSync" Width="680" Height="760" MinWidth="620" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{StaticResource CanvasBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="NOVO ESPAÇO DE PRODUÇÃO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
            <TextBlock Text="Vamos preparar seu projeto" FontSize="27" FontWeight="Bold" Margin="0,6,0,4" />
            <TextBlock Text="Cadastre os dados básicos agora. Você pode completar as informações depois." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Nome do projeto" FontSize="12" FontWeight="SemiBold" />
                        <TextBox x:Name="NameInput" Margin="0,5,0,12" MaxLength="160" />
                        <TextBlock Text="Título do jogo" FontSize="12" FontWeight="SemiBold" />
                        <TextBox x:Name="GameTitleInput" Margin="0,5,0,12" MaxLength="160" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Versão (opcional)" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="GameVersionInput" Margin="0,5,0,0" MaxLength="80" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Plataforma (opcional)" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="PlatformInput" Margin="0,5,0,0" MaxLength="80" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="NARRATIVA E IDIOMAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Estrutura narrativa" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="NarrativeInput" SelectedIndex="2" Margin="0,5,0,12">
                            <ComboBoxItem Content="Linear" Tag="linear" />
                            <ComboBoxItem Content="Com vários caminhos" Tag="branching" />
                            <ComboBoxItem Content="Ainda não definido" Tag="unknown" />
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Idioma original" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="OriginalLanguageInput" Text="en" Margin="0,5,0,0" MaxLength="16"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Idioma capturado" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="CaptureLanguageInput" Text="en" Margin="0,5,0,0" MaxLength="16"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Idioma da dublagem" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="DubLanguageInput" Text="pt-BR" Margin="0,5,0,0" MaxLength="16"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,13">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CAPA DO PROJETO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Opcional; você poderá adicionar ou trocar depois." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="Escolher imagem" Padding="12,7" Click="ChooseCover_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="CoverPreviewBorder" Height="92" CornerRadius="8" Background="#0B1421" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,12,0,0" ClipToBounds="True">
                            <Grid><Image x:Name="CoverPreview" Stretch="UniformToFill" Visibility="Collapsed"/><TextBlock x:Name="CoverHint" Text="Sem capa selecionada" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#FF777E" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,0,2,8" />
                <CheckBox x:Name="OpenAfterCreateInput" Content="Abrir o projeto depois de criar" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="2,0,0,8" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,20,0,0">
            <TextBlock Text="O projeto será salvo no banco atual do DubSync." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Cancelar" Margin="0,0,9,0" MinWidth="96" IsCancel="True" />
                <Button Content="Criar projeto" Style="{StaticResource PrimaryButton}" MinWidth="130" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
