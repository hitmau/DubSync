<UserControl x:Class="DubSync.Desktop.Views.ProjectHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,34">
            <TextBlock Text="SEU WORKSPACE" Foreground="{StaticResource TealBrush}" FontSize="11" FontWeight="Bold" />
            <Grid Margin="0,6,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Projetos" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="Retome uma história ou prepare um novo jogo para receber vozes." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋  Novo projeto" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="150" Click="NewProject_Click" />
            </Grid>

            <Border BorderBrush="#2A4869" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,25">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#163451" Offset="0" />
                        <GradientStop Color="#102033" Offset="0.58" />
                        <GradientStop Color="#0D1828" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DUBSYNC DESKTOP" Foreground="{StaticResource TealBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Da primeira fala ao jogo dublado." FontSize="23" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="A base nativa está sendo construída por módulos. Seus projetos e o banco atual continuam conectados ao mesmo serviço." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="630" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1A3854" BorderBrush="#345B7E" BorderThickness="1" CornerRadius="13" Padding="18,14" Margin="22,0,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="CONEXÃO LOCAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="8" Height="8" Fill="{Binding ConnectionDotBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding ApiEndpoint}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="16,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Seus projetos" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Cada projeto guarda seu progresso, personagens, falas e evidências." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Atualizar" Click="Refresh_Click" Padding="12,7" VerticalAlignment="Center" />
            </Grid>

            <Border Visibility="{Binding ProjectsEmptyVisibility}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,4,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyProjectsTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EmptyProjectsDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Projects}" Visibility="{Binding ProjectsVisibility}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,14" Padding="0" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border CornerRadius="13,13,0,0" ClipToBounds="True" Background="#172A40">
                                    <Grid>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                    <GradientStop Color="#174C6D" Offset="0" />
                                                    <GradientStop Color="#1B2F53" Offset="0.52" />
                                                    <GradientStop Color="#171E38" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" Opacity="0.78" />
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#D508111D" Offset="0" />
                                                    <GradientStop Color="#66101D2B" Offset="0.65" />
                                                    <GradientStop Color="#00101D2B" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="20,0,20,0">
                                            <TextBlock Text="{Binding GameTitle}" FontSize="11" FontWeight="Bold" Foreground="#B7C9DE" />
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Background="#D8172A40" BorderBrush="#526D8B" BorderThickness="1" CornerRadius="10" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,14,0">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="18,15,18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StageLabel}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Summary.ProgressPercent, StringFormat={}{0:0}%}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding Summary.ProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,11" Background="#263A52" Foreground="{StaticResource TealBrush}" BorderThickness="0" />
                                    <UniformGrid Columns="3" Margin="0,0,0,15">
                                        <StackPanel><TextBlock Text="{Binding Summary.Dialogues}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="FALAS" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Summary.Characters}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PERSONAGENS" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Summary.Takes}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="TAKES" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                                    </UniformGrid>
                                    <Button Content="Abrir projeto  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Tag="{Binding}" Click="OpenProject_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
