<Window x:Class="DubSync.Desktop.Views.OcrRetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova leitura OCR" Width="720" Height="625" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="REVISÃO DE OCR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
            <TextBlock Text="Compare antes de aplicar" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" />
            <TextBlock x:Name="InfoText" Text="A leitura nova e as imagens ficam no histórico." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,15" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Texto salvo atualmente" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="PreviousText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="58" MaxHeight="92" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Nova leitura / correção (editável)" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="CandidateText" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="120" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Personagem encontrado na área configurada" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="SpeakerText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="42" MaxHeight="64" Margin="0,5,0,0" />
            <CheckBox x:Name="ApplySpeakerCheck" Content="Aplicar também este personagem" Margin="0,9,0,0" Foreground="{StaticResource TextBrush}" />
        </StackPanel>
        <Border Grid.Row="4" Background="#122238" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14">
            <TextBlock Text="O OCR original permanece preservado. Ao aplicar, o texto corrigido e o personagem escolhido são sincronizados com a revisão e as ocorrências da Dublagem." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
        </Border>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource AmberBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Manter dados atuais" Click="Keep_Click" Padding="13,8" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Aplicar correção" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Padding="15,8" />
        </Grid>
    </Grid>
</Window>
