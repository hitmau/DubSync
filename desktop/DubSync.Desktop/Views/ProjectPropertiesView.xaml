<UserControl x:Class="DubSync.Desktop.Views.ProjectPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="17,13">
            <TextBlock Text="PROJETO ATIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding SelectedProject.Name, TargetNullValue='Nenhum projeto selecionado'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,2" />
            <TextBlock Text="{Binding SelectedProject.GameTitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            <Separator Margin="0,17,0,13" />
            <TextBlock Text="ETAPA ATUAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding SelectedProject.StageLabel, TargetNullValue='—'}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,13" />
            <TextBlock Text="PROGRESSO GERAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            <ProgressBar Value="{Binding SelectedProject.Summary.ProgressPercent}" Maximum="100" Height="7" Margin="0,8,0,4" Background="#263A52" Foreground="{StaticResource TealBrush}" BorderThickness="0" />
            <TextBlock Text="{Binding SelectedProject.Summary.ProgressPercent, StringFormat={}{0:0}% concluído}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            <UniformGrid Columns="2" Margin="0,18,0,0">
                <StackPanel Margin="0,0,8,12"><TextBlock Text="{Binding SelectedProject.Summary.Dialogues, TargetNullValue=0}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="FALAS" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding SelectedProject.Summary.Characters, TargetNullValue=0}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="PERSONAGENS" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel><TextBlock Text="{Binding SelectedProject.Summary.Sessions, TargetNullValue=0}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="SESSÕES" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel><TextBlock Text="{Binding SelectedProject.Summary.ApprovedTakes, TargetNullValue=0}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="TAKES APROVADOS" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </UniformGrid>
            <Border Background="#122235" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,20,0,0">
                <TextBlock Text="Os dados continuam no banco DubSync existente. Este painel apenas consulta e abre projetos pela API local." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
